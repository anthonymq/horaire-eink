#ifndef CONFIG_H
#define CONFIG_H

// API Configuration
#define API_URL "https://prim.iledefrance-mobilites.fr/marketplace/stop-monitoring?MonitoringRef=STIF:StopArea:SP:46366:"
#define API_TOKEN "YOUR_IDFM_API_TOKEN"
#define API_URL_323 "https://prim.iledefrance-mobilites.fr/marketplace/stop-monitoring?MonitoringRef=STIF:StopPoint:Q:39570:"
#define API_URL_323_JULES_FERRY "https://prim.iledefrance-mobilites.fr/marketplace/stop-monitoring?MonitoringRef=STIF:StopPoint:Q:39571:"

// OpenWeatherMap API Configuration
#define WEATHER_API_KEY "YOUR_OPENWEATHERMAP_API_KEY"
#define WEATHER_API_URL "https://api.openweathermap.org/data/2.5/weather"
#define WEATHER_CITY "Ivry-sur-Seine"
#define WEATHER_UNITS "metric" // Use metric units (Celsius)

// Station configuration using simple C arrays (avoid global std::map/vector crashes on ESP32)
// IMPORTANT: Do NOT use STL containers (std::map, std::vector) for global config - causes boot crash
struct StationConfig {
    const char* name;
    const char* endpoint;
    const char* type;        // "RER", "BUS", "METRO", "TRAM"
    const char* filter;      // Platform name for RER, operator for BUS
    bool showNames;          // Show destination names (true for RER, false for BUS)
    int maxEntries;          // Max departures to display (1-6)
    const char* displayName; // Name shown in UI banner
};

// Station configurations - order matters for display layout:
// - First station: RER section (full width, shows destination names)
// - Second station: Bus left column
// - Third station: Bus right column
const StationConfig STATIONS[] = {
    {
        "RER C",
        "https://prim.iledefrance-mobilites.fr/marketplace/stop-monitoring?MonitoringRef=STIF:StopArea:SP:46366:",
        "RER",
        "2B",      // Filter by platform 2B
        true,      // Show destination names
        6,
        "RER C"
    },
    {
        "323 Moliere",
        "https://prim.iledefrance-mobilites.fr/marketplace/stop-monitoring?MonitoringRef=STIF:StopPoint:Q:39570:",
        "BUS",
        "MeC_Bus_PC:Operator::100:",  // Filter by operator
        false,     // Don't show destination names for bus
        6,
        "323 Moliere"
    },
    {
        "323 Jules Ferry",
        "https://prim.iledefrance-mobilites.fr/marketplace/stop-monitoring?MonitoringRef=STIF:StopPoint:Q:39571:",
        "BUS",
        "MeC_Bus_PC:Operator::100:",
        false,
        6,
        "323 Jules F"
    }
};

const int NUM_STATIONS = sizeof(STATIONS) / sizeof(STATIONS[0]);

// WiFi credentials - supports multiple networks via WiFiMulti
// Device will try each network in order until one connects
struct WifiCredential {
    const char* ssid;
    const char* password;
};

const WifiCredential WIFI_CREDENTIALS[] = {
    {"YOUR_WIFI_SSID", "YOUR_WIFI_PASSWORD"}
    // Add more networks as needed:
    // {"Second_Network", "password2"},
    // {"Mobile_Hotspot", "password3"}
};

const int NUM_WIFI_CREDENTIALS = sizeof(WIFI_CREDENTIALS) / sizeof(WIFI_CREDENTIALS[0]);

#endif // CONFIG_H
